# Stellar Ops local development environment
STELLAR_OPS_ENV=DEVELOPMENT
PORT=5001

# Set a unique value locally. Never commit the real secret.
STELLAR_OPS_SECRET=replace-with-a-long-random-local-secret

# Optional build identity for non-GitHub deployments.
STELLAR_OPS_COMMIT=LOCAL

# Canonical HTTPS origin used by production deployment checks.
STELLAR_OPS_PUBLIC_URL=http://localhost:5001

# Set to 1 for read-only maintenance mode.
STELLAR_OPS_MAINTENANCE=0

# Keep production backups on a separate mounted volume.
# STELLAR_OPS_BACKUPS=/mnt/stellar-ops-backups
STELLAR_OPS_BACKUP_RETENTION=20

# Production must keep Flask debug disabled.
FLASK_DEBUG=0
